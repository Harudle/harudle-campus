# 이 설정은 로컬 LiveKit 시험용입니다. 운영 환경에서는 아래 관리 모드가 필요합니다.
MEDIA_PROVIDER=livekit
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# 아래 값은 별도 로컬 시험을 준비할 때만 사용합니다. 실제 비밀값을 이 파일에 넣지 마세요.
# DAILY_DOMAIN=
# DAILY_API_KEY=
# CLOUDFLARE_SFU_APP_ID=
# CLOUDFLARE_SFU_SECRET=
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_ANALYTICS_TOKEN=
# CLOUDFLARE_WATCHDOG_URL=
# CLOUDFLARE_WATCHDOG_TOKEN=

# 운영에서만 사용하는 예시. 기존 사용량 확인과 DB 준비가 먼저 필요합니다.
# MEDIA_PROVIDER=managed-draft
# MEDIA_SINGLE_HOST=1
# MEDIA_MEETINGS=persistent
# MEDIA_NAMESPACE=campus
# MEDIA_STATE_PATH=/var/lib/harudle-campus/media.sqlite
# CAMPUS_PUBLIC_ORIGIN=https://campus.harudle.com
# CAMPUS_TRUST_PROXY=1
# MEDIA_MAX_PARTICIPANTS=20
# MEDIA_JOIN_PER_IP_PER_MINUTE=12
# CLOUDFLARE_BUDGET_BYTES=

# 하루들 로그인 연동 (docs/harudle-login.md). 비밀값이나 저장소가 없으면 연동 버튼이 숨고 모두 게스트로 동작합니다.
# CAMPUS_AUTH_ORIGIN=http://localhost:8090          # 캠퍼스 자기 주소. 없으면 CAMPUS_PUBLIC_ORIGIN
# HARUDLE_BASE_URL=https://dev.harudle.com          # 기본값 https://www.harudle.com
# HARUDLE_CAMPUS_SIGNING_KEY=                       # 하루들과 나눠 가진 HS256 서명 키(Base64, 32바이트 이상). 하루들 HARUDLE_CAMPUS_SIGNING_KEY_BASE64와 같은 값
# SUPABASE_URL=https://<project>.supabase.co        # 표: docs/supabase/campus-auth.sql
# SUPABASE_SERVICE_ROLE_KEY=                        # 서버 전용 비밀 키(sb_secret_…, 예전 service_role JWT도 됨). 브라우저로 나가지 않습니다
# CAMPUS_AUTH_STORE=memory                          # 로컬 확인용(운영에서는 무시). 워커가 바뀌면 로그아웃됩니다

# 캠퍼스 지갑 '컷' (docs/campus-wallet.md). 하루들 로그인 연동이 켜져 있어야 하고, Supabase에 docs/supabase/campus-wallet.sql을 먼저 실행해 둡니다.
# CAMPUS_WALLET=on                                  # 없으면 꺼짐(/api/me/wallet 404)
# CAMPUS_WALLET_FEED_REWARD=10                      # 하루들 피드에 올린 날 하루 한 번 주는 컷(1~1000, 기본 10)
