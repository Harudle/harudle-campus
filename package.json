{
  "name": "wooteco-metaverse",
  "version": "1.0.0",
  "description": "하루들 캐릭터로 걷는 우아한테크코스 판교 캠퍼스 11~14층 3D 메타버스",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build && vite build --mode artifact && node scripts/build-info.mjs",
    "check": "node scripts/check.mjs",
    "test": "node --test scripts/*.test.mjs",
    "serve": "PORT=8080 node server.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "livekit-server-sdk": "2.18.0",
    "ws": "8.22.2"
  },
  "license": "MIT",
  "devDependencies": {
    "@daily-co/daily-js": "0.95.0",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/suncalc": "^1.9.2",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "^6.2.1",
    "esbuild": "*",
    "livekit-client": "2.23.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "suncalc": "^2.1.3",
    "three": "0.187.0",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vite-plugin-singlefile": "2.3.4"
  }
}
